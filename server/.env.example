# Set these in Vercel → Project Settings → Environment Variables.
# JWT_SECRET, ADMIN_PASSWORD and RIDER_PASSWORD are REQUIRED in production
# (the server refuses to start without them). Locally, dev defaults are used.

# Long random string used to sign login tokens, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial passwords, used only when the users table is first created
ADMIN_PASSWORD=
RIDER_PASSWORD=

# Comma-separated frontend URLs allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:4200
